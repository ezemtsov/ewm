--- a/src/pgtkterm.c
+++ b/src/pgtkterm.c
@@ -10801,6 +10801,803 @@
   return stats;
 }
 
+static Lisp_Object
+pgtk_skia_test_pointer (const void *ptr)
+{
+  return ptr ? make_uint ((uintmax_t) (uintptr_t) ptr) : Qnil;
+}
+
+static Lisp_Object
+pgtk_skia_test_rect (int x, int y, int width, int height)
+{
+  return list4i (x, y, width, height);
+}
+
+static bool
+pgtk_skia_test_decode_rect (Lisp_Object rect, int *x, int *y,
+			    int *width, int *height)
+{
+  if (!CONSP (rect))
+    return false;
+
+  Lisp_Object rest = rect;
+  Lisp_Object vals[4];
+  for (int i = 0; i < 4; i++)
+    {
+      if (!CONSP (rest) || !FIXNUMP (XCAR (rest)))
+	return false;
+      vals[i] = XCAR (rest);
+      rest = XCDR (rest);
+    }
+
+  *x = XFIXNUM (vals[0]);
+  *y = XFIXNUM (vals[1]);
+  *width = XFIXNUM (vals[2]);
+  *height = XFIXNUM (vals[3]);
+  return *width > 0 && *height > 0;
+}
+
+static bool
+pgtk_skia_test_ensure_surface (struct frame *f)
+{
+  if (!FRAME_SKIA_SURFACE (f) || !FRAME_SKIA_CANVAS (f))
+    {
+      emacs_skia_canvas_t *canvas = pgtk_begin_skia_clip (f);
+      if (!canvas)
+	return false;
+      pgtk_end_skia_clip (f);
+    }
+
+  return FRAME_SKIA_SURFACE (f) && FRAME_SKIA_CANVAS (f);
+}
+
+static void
+pgtk_skia_test_fill_rect (struct frame *f, unsigned long color,
+			  int x, int y, int width, int height,
+			  bool respect_alpha_background)
+{
+  pgtk_fill_rectangle (f, color, x, y, width, height,
+		       respect_alpha_background);
+}
+
+static void
+pgtk_skia_test_set_paint (struct frame *f, unsigned long color,
+			  bool respect_alpha_background)
+{
+  emacs_skia_paint_t *paint = FRAME_SKIA_PAINT (f);
+
+  pgtk_skia_set_paint_color (f, color, respect_alpha_background);
+  emacs_skia_paint_set_image_shader (paint, NULL);
+  emacs_skia_paint_set_dash (paint, NULL, 0, 0.0f);
+  emacs_skia_paint_set_stroke (paint, false);
+}
+
+static bool
+pgtk_skia_test_draw_clipped_regions (struct frame *f, XRectangle *clips,
+				     int nclips, int x, int y,
+				     int width, int height)
+{
+  emacs_skia_canvas_t *canvas = pgtk_begin_skia_clip (f);
+  if (!canvas)
+    return false;
+
+  pgtk_skia_set_clip_rectangles (canvas, clips, nclips);
+  pgtk_skia_test_set_paint (f, 0xff0000, false);
+
+  emacs_skia_rect_t rect = { x, y, x + width, y + height };
+  emacs_skia_canvas_draw_rect (canvas, &rect, FRAME_SKIA_PAINT (f));
+  pgtk_gl_note_damage (f, x, y, width, height);
+  pgtk_end_skia_clip (f);
+  return true;
+}
