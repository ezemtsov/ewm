+DEFUN ("pgtk-skia-test-copy-bits-snapshot-fallback",
+       Fpgtk_skia_test_copy_bits_snapshot_fallback,
+       Spgtk_skia_test_copy_bits_snapshot_fallback, 0, 1, 0,
+       doc: /* Exercise copy_bits snapshot fallback and return destination.  */)
+(Lisp_Object frame)
+{
+  struct frame *f = decode_window_system_frame (frame);
+  int x = 32, y = 32, w = 80, h = 50;
+  cairo_rectangle_t src = { x, y, w, h };
+  cairo_rectangle_t dst = { x + 110, y, w, h };
+
+  block_input ();
+  pgtk_skia_test_fill_rect (f, 0x00ff00, x, y, 220, h, true);
