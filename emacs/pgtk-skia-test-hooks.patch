+DEFUN ("pgtk-skia-test-abandon-gl-context",
+       Fpgtk_skia_test_abandon_gl_context,
+       Spgtk_skia_test_abandon_gl_context, 0, 1, 0,
+       doc: /* Force FRAME's Skia GL context into abandoned state.  */)
+(Lisp_Object frame)
+{
+  struct frame *f = decode_window_system_frame (frame);
+
+  if (!FRAME_GDK_GL_CONTEXT (f) && !FRAME_SKIA_GL_CONTEXT (f)
+      && !FRAME_GL_FRAMEBUFFER (f) && !FRAME_GL_TEXTURE (f))
+    return Qnil;
+
+  block_input ();
+  pgtk_abandon_gl_context (f);
+  pgtk_cancel_gl_context_recreate (f);
+  FRAME_GL_CONTEXT_RECREATE_AFTER (f) = 0;
+  if (FRAME_GL_DRAWING_AREA (f))
+    {
+      SET_FRAME_GARBAGED (f);
+      pgtk_gl_note_full_damage (f);
+      pgtk_gl_queue_draw (f);
+    }
+  unblock_input ();
+  return Qt;
+}
