+DEFUN ("pgtk-skia-test-framebuffer-size",
+       Fpgtk_skia_test_framebuffer_size,
+       Spgtk_skia_test_framebuffer_size, 0, 1, 0,
+       doc: /* Return Skia GL framebuffer size diagnostics for FRAME.  */)
+(Lisp_Object frame)
+{
+  struct frame *f = decode_window_system_frame (frame);
+  int scale = pgtk_gl_scale (f);
+
+  return listn (7,
+		make_fixnum (FRAME_GL_RENDER_WIDTH (f)),
+		make_fixnum (FRAME_GL_RENDER_HEIGHT (f)),
+		make_fixnum (FRAME_GL_TEXTURE_WIDTH (f)),
+		make_fixnum (FRAME_GL_TEXTURE_HEIGHT (f)),
+		make_fixnum (FRAME_PIXEL_WIDTH (f)),
+		make_fixnum (FRAME_PIXEL_HEIGHT (f)),
+		make_fixnum (scale));
+}
+
+DEFUN ("pgtk-skia-test-framebuffer-color-counts",
+       Fpgtk_skia_test_framebuffer_color_counts,
+       Spgtk_skia_test_framebuffer_color_counts, 0, 2, 0,
+       doc: /* Return red/green pixel counts from FRAME's Skia GL texture.  */)
+(Lisp_Object frame, Lisp_Object rect)
+{
+  struct frame *f = decode_window_system_frame (frame);
+  int logical_x = 0;
+  int logical_y = 0;
+  int logical_width = FRAME_PIXEL_WIDTH (f);
+  int logical_height = FRAME_PIXEL_HEIGHT (f);
+  int scale = pgtk_gl_scale (f);
+  int render_width = FRAME_GL_RENDER_WIDTH (f);
+  int render_height = FRAME_GL_RENDER_HEIGHT (f);
+  int x0, y0, x1, y1;
+  int read_width, read_height;
+  unsigned char *pixels;
+  int red_count = 0;
+  int green_count = 0;
+  int translucent_green_count = 0;
+  int red_min_x = INT_MAX;
+  int red_min_y = INT_MAX;
+  int red_max_x = -1;
+  int red_max_y = -1;
+  GLint old_pack_alignment = 0;
+  struct pgtk_fbo_bindings saved_fbo;
+  Lisp_Object bounds;
+  Lisp_Object result = Qnil;
+
+  if (!NILP (rect)
+      && !pgtk_skia_test_decode_rect (rect, &logical_x, &logical_y,
+				      &logical_width, &logical_height))
+    return Qnil;
+
+  if (!FRAME_GDK_GL_CONTEXT (f) || !FRAME_GL_FRAMEBUFFER (f)
+      || render_width <= 0 || render_height <= 0)
+    return Qnil;
+
+  x0 = max (0, logical_x * scale);
+  x1 = min (render_width, (logical_x + logical_width) * scale);
+  y0 = max (0, render_height - (logical_y + logical_height) * scale);
+  y1 = min (render_height, render_height - logical_y * scale);
+  read_width = x1 - x0;
+  read_height = y1 - y0;
+  if (read_width <= 0 || read_height <= 0)
+    return listn (6,
+		  make_fixnum (render_width),
+		  make_fixnum (render_height),
+		  make_fixnum (0), make_fixnum (0), make_fixnum (0),
+		  Qnil);
+
+  pixels = xmalloc ((size_t) read_width * (size_t) read_height * 4);
+
+  block_input ();
+  if (pgtk_skia_test_ensure_surface (f)
+      && pgtk_skia_make_gl_context_current (f))
+    {
+      emacs_skia_surface_flush (FRAME_SKIA_SURFACE (f));
+      pgtk_save_fbo_bindings (&saved_fbo);
+      glGetIntegerv (GL_PACK_ALIGNMENT, &old_pack_alignment);
+      glPixelStorei (GL_PACK_ALIGNMENT, 1);
+      glBindFramebuffer (GL_READ_FRAMEBUFFER, FRAME_GL_FRAMEBUFFER (f));
+      glReadPixels (x0, y0, read_width, read_height, GL_RGBA,
+		    GL_UNSIGNED_BYTE, pixels);
+      glPixelStorei (GL_PACK_ALIGNMENT, old_pack_alignment);
+      pgtk_restore_fbo_bindings (f, &saved_fbo);
+
+      if (!pgtk_check_gl_error ("pgtk-skia-test-framebuffer-color-counts"))
+	{
+	  for (int yy = 0; yy < read_height; yy++)
+	    {
+	      for (int xx = 0; xx < read_width; xx++)
+		{
+		  unsigned char *p = pixels + ((yy * read_width + xx) * 4);
+		  int r = p[0];
+		  int g = p[1];
+		  int b = p[2];
+		  int a = p[3];
+
+		  if (r > 200 && g < 100 && b < 100)
+		    {
+		      int device_x = x0 + xx;
+		      int device_y = y0 + yy;
+		      red_count++;
+		      red_min_x = min (red_min_x, device_x);
+		      red_min_y = min (red_min_y, device_y);
+		      red_max_x = max (red_max_x, device_x);
+		      red_max_y = max (red_max_y, device_y);
+		    }
+		  if (g > 120 && r < 120 && b < 120)
+		    {
+		      green_count++;
+		      if (a > 0 && a < 250)
+			translucent_green_count++;
+		    }
+		}
+	    }
+
+	  bounds = red_count > 0
+	    ? list4i (red_min_x, red_min_y, red_max_x, red_max_y)
+	    : Qnil;
+	  result = listn (6,
+			  make_fixnum (render_width),
+			  make_fixnum (render_height),
+			  make_fixnum (red_count),
+			  make_fixnum (green_count),
+			  make_fixnum (translucent_green_count),
+			  bounds);
+	}
+    }
+  unblock_input ();
+
+  xfree (pixels);
+  return result;
+}
+
+DEFUN ("pgtk-skia-test-context-state",
+       Fpgtk_skia_test_context_state,
+       Spgtk_skia_test_context_state, 1, 2, 0,
+       doc: /* Return Skia/GDK GL context diagnostics for FRAME.  */)
+(Lisp_Object frame, Lisp_Object ensure_current)
+{
+  struct frame *f = decode_window_system_frame (frame);
+  GdkGLContext *current;
+  void *direct_context = NULL;
+  int resource_count = 0;
+  size_t resource_bytes = 0;
+  int max_resources = 0;
+  size_t max_resource_bytes = 0;
+  size_t purgeable_bytes = 0;
+  Lisp_Object state;
+
+  block_input ();
+  if (!NILP (ensure_current))
+    pgtk_skia_make_gl_context_current (f);
+
+  current = gdk_gl_context_get_current ();
+  if (FRAME_SKIA_GL_CONTEXT (f))
+    emacs_skia_gl_context_get_diagnostics (FRAME_SKIA_GL_CONTEXT (f),
+					   &direct_context,
+					   &resource_count,
+					   &resource_bytes,
+					   &max_resources,
+					   &max_resource_bytes,
+					   &purgeable_bytes);
+
+  state = listn (9,
+		 pgtk_skia_test_pointer (FRAME_GDK_GL_CONTEXT (f)),
+		 pgtk_skia_test_pointer (FRAME_SKIA_GL_CONTEXT (f)),
+		 current == FRAME_GDK_GL_CONTEXT (f) ? Qt : Qnil,
+		 pgtk_skia_test_pointer (direct_context),
+		 make_uint (resource_count),
+		 make_uint (resource_bytes),
+		 FRAME_GL_FRAMEBUFFER (f)
+		   ? make_uint (FRAME_GL_FRAMEBUFFER (f)) : Qnil,
+		 FRAME_GL_TEXTURE (f)
+		   ? make_uint (FRAME_GL_TEXTURE (f)) : Qnil,
+		 pgtk_skia_test_pointer (
+		   FRAME_GDK_GL_CONTEXT (f)
+		     ? gdk_gl_context_get_shared_context (
+			 FRAME_GDK_GL_CONTEXT (f))
+		     : NULL));
+  unblock_input ();
+
+  return state;
+}
+
+DEFUN ("pgtk-skia-test-texture-shared-p",
+       Fpgtk_skia_test_texture_shared_p,
+       Spgtk_skia_test_texture_shared_p, 2, 2, 0,
+       doc: /* Return non-nil if FRAME-A can see FRAME-B's GL texture.  */)
+(Lisp_Object frame_a, Lisp_Object frame_b)
+{
+  struct frame *fa = decode_window_system_frame (frame_a);
+  struct frame *fb = decode_window_system_frame (frame_b);
+  bool shared = false;
+
+  if (!FRAME_GDK_GL_CONTEXT (fa) || !FRAME_GL_TEXTURE (fb))
+    return Qnil;
+
+  block_input ();
+  if (pgtk_skia_make_gl_context_current (fa))
+    shared = glIsTexture (FRAME_GL_TEXTURE (fb));
+  unblock_input ();
+
+  return shared ? Qt : Qnil;
+}
