+DEFUN ("pgtk-skia-test-clear-area",
+       Fpgtk_skia_test_clear_area,
+       Spgtk_skia_test_clear_area, 0, 1, 0,
+       doc: /* Exercise pgtk_clear_area and return checked rectangles.  */)
+(Lisp_Object frame)
+{
+  struct frame *f = decode_window_system_frame (frame);
+  int x = 24;
+  int y = 24;
+  int w = min (240, max (120, FRAME_PIXEL_WIDTH (f) / 2));
+  int h = min (90, max (45, FRAME_PIXEL_HEIGHT (f) / 3));
+  int side = w / 3;
+
+  if (FRAME_PIXEL_WIDTH (f) < x + w)
+    x = max (0, FRAME_PIXEL_WIDTH (f) - w);
+  if (FRAME_PIXEL_HEIGHT (f) < y + h)
+    y = max (0, FRAME_PIXEL_HEIGHT (f) - h);
+
+  block_input ();
+  pgtk_skia_test_fill_rect (f, 0x00ff00, x, y, w, h, true);
+  pgtk_skia_test_fill_rect (f, 0xff0000, x, y, side, h, false);
+  pgtk_skia_test_fill_rect (f, 0xff0000, x + 2 * side, y,
+			    w - 2 * side, h, false);
+  pgtk_clear_area (f, x + side, y, side, h);
+  if (FRAME_SKIA_SURFACE (f))
+    emacs_skia_surface_flush (FRAME_SKIA_SURFACE (f));
+  unblock_input ();
+
+  return list3 (pgtk_skia_test_rect (x, y, side, h),
+		pgtk_skia_test_rect (x + side, y, side, h),
+		pgtk_skia_test_rect (x + 2 * side, y, w - 2 * side, h));
+}
