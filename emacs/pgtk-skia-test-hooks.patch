+DEFUN ("pgtk-skia-test-current-tooltip-frame",
+       Fpgtk_skia_test_current_tooltip_frame,
+       Spgtk_skia_test_current_tooltip_frame, 0, 0, 0,
+       doc: /* Return the currently live PGTK tooltip frame, if any.  */)
+(void)
+{
+  Lisp_Object tail, frame;
+
+  FOR_EACH_FRAME (tail, frame)
+    {
+      struct frame *f = XFRAME (frame);
+      if (FRAME_PGTK_P (f) && f->tooltip && FRAME_VISIBLE_P (f))
+	return frame;
+    }
+
+  return Qnil;
+}
