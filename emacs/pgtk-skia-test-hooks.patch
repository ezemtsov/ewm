+DEFUN ("pgtk-skia-test-force-surface-update",
+       Fpgtk_skia_test_force_surface_update,
+       Spgtk_skia_test_force_surface_update, 0, 1, 0,
+       doc: /* Force FRAME's Skia surface update path and report replacement.  */)
+(Lisp_Object frame)
+{
+  struct frame *f = decode_window_system_frame (frame);
+  emacs_skia_surface_t *old_surface = FRAME_SKIA_SURFACE (f);
+  int width = FRAME_PIXEL_WIDTH (f);
+  int height = FRAME_PIXEL_HEIGHT (f);
+
+  if (!old_surface)
+    pgtk_skia_test_ensure_surface (f);
+  old_surface = FRAME_SKIA_SURFACE (f);
+  if (!old_surface)
+    return Qnil;
+
+  pgtk_skia_update_surface_desired_size (f, width, height, true);
+  return FRAME_SKIA_SURFACE (f) != old_surface ? Qt : Qnil;
+}
