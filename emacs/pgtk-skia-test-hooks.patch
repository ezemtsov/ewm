+DEFUN ("pgtk-skia-test-copy-bits-damage",
+       Fpgtk_skia_test_copy_bits_damage,
+       Spgtk_skia_test_copy_bits_damage, 0, 1, 0,
+       doc: /* Exercise copy_bits damage tracking and return diagnostics.  */)
+(Lisp_Object frame)
+{
+  struct frame *f = decode_window_system_frame (frame);
+  int x = 32, y = 96, w = 100, h = 50;
+  cairo_rectangle_t src = { x, y, w, h };
+  cairo_rectangle_t dst = { x + 120, y, w, h };
+  Lisp_Object dst_rect;
+  Lisp_Object damage_rect;
+
+  block_input ();
+  pgtk_skia_test_fill_rect (f, 0x00ff00, x, y, w + 160, h, true);
+  pgtk_skia_test_fill_rect (f, 0xff0000, x, y, w, h, false);
+  if (FRAME_SKIA_SURFACE (f))
+    emacs_skia_surface_flush (FRAME_SKIA_SURFACE (f));
+
+  FRAME_GL_DAMAGE_VALID (f) = false;
+  FRAME_GL_DAMAGE_FULL (f) = false;
+  FRAME_GL_DAMAGE_X (f) = 0;
+  FRAME_GL_DAMAGE_Y (f) = 0;
+  FRAME_GL_DAMAGE_WIDTH (f) = 0;
+  FRAME_GL_DAMAGE_HEIGHT (f) = 0;
+
+  pgtk_copy_bits (f, &src, &dst);
+  if (FRAME_SKIA_SURFACE (f))
+    emacs_skia_surface_flush (FRAME_SKIA_SURFACE (f));
+
+  dst_rect = pgtk_skia_test_rect ((int) dst.x, (int) dst.y,
+				  (int) dst.width, (int) dst.height);
+  damage_rect = FRAME_GL_DAMAGE_VALID (f)
+    ? pgtk_skia_test_rect (FRAME_GL_DAMAGE_X (f),
+			   FRAME_GL_DAMAGE_Y (f),
+			   FRAME_GL_DAMAGE_WIDTH (f),
+			   FRAME_GL_DAMAGE_HEIGHT (f))
+    : Qnil;
+  unblock_input ();
+
+  return list4 (dst_rect, damage_rect,
+		FRAME_GL_DAMAGE_VALID (f) ? Qt : Qnil,
+		FRAME_GL_DAMAGE_FULL (f) ? Qt : Qnil);
+}
