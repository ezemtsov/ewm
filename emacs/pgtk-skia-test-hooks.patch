+DEFUN ("pgtk-skia-test-draw-relief-polarity",
+       Fpgtk_skia_test_draw_relief_polarity,
+       Spgtk_skia_test_draw_relief_polarity, 0, 1, 0,
+       doc: /* Draw raised/sunken relief samples and return edge rects.  */)
+(Lisp_Object frame)
+{
+  struct frame *f = decode_window_system_frame (frame);
+  int x = 28, y = 28, w = 96, h = 48, thick = 6;
+  XRectangle clip = { 0, 0, FRAME_PIXEL_WIDTH (f), FRAME_PIXEL_HEIGHT (f) };
+  struct pgtk_output *di = FRAME_X_OUTPUT (f);
+
+  di->relief_background_valid_p = true;
+  di->relief_background = 0x000000;
+  FRAME_X_OUTPUT (f)->white_relief.xgcv.foreground = 0xff0000;
+  FRAME_X_OUTPUT (f)->black_relief.xgcv.foreground = 0x00ff00;
+
+  block_input ();
+  pgtk_skia_test_fill_rect (f, 0x00ff00, x, y, w, h, true);
+  pgtk_draw_relief_rect (f, x, y, x + w - 1, y + h - 1,
+			 thick, thick, true, true, true, true, true,
+			 &clip);
+  pgtk_skia_test_fill_rect (f, 0x00ff00, x + w + 48, y, w, h, true);
+  pgtk_draw_relief_rect (f, x + w + 48, y, x + w + 48 + w - 1,
+			 y + h - 1, thick, thick, false,
+			 true, true, true, true, &clip);
+  if (FRAME_SKIA_SURFACE (f))
+    emacs_skia_surface_flush (FRAME_SKIA_SURFACE (f));
+  unblock_input ();
+
+  return listn (4,
+		pgtk_skia_test_rect (x, y, w, thick),
+		pgtk_skia_test_rect (x, y + h - thick, w, thick),
+		pgtk_skia_test_rect (x + w + 48, y, w, thick),
+		pgtk_skia_test_rect (x + w + 48, y + h - thick,
+				      w, thick));
+}
