+  glBindFramebuffer (GL_DRAW_FRAMEBUFFER, FRAME_GL_FRAMEBUFFER (f));
+  glBlitFramebuffer (0, 0, blit_width, blit_height, 0, 0, blit_width,
+		     blit_height, GL_COLOR_BUFFER_BIT, GL_NEAREST);
