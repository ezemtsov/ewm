+/* Set up GL framebuffer for rendering at given size.  */
+static bool
+pgtk_setup_gl_framebuffer (struct frame *f, int width, int height,
+			   bool flush_clear)
+{
+  int alloc_width, alloc_height;
+  bool resize_storage;
+  bool create_stencil;
+  GLint old_texture = 0;
+  GLint old_renderbuffer = 0;
+  struct pgtk_fbo_bindings saved_fbo;
+  bool ok = false;
+
+  if (width <= 0 || height <= 0)
+    return false;
+
+  if (!FRAME_GDK_GL_CONTEXT (f))
+    return false;
+
+  /* Make the GL context current.  */
+  if (!pgtk_frame_gl_context_make_current (f))
+    return false;
+
+  /* Clear any stale GL errors before starting.  */
+  pgtk_clear_gl_errors ();
+
+  alloc_width = FRAME_GL_TEXTURE_WIDTH (f);
+  alloc_height = FRAME_GL_TEXTURE_HEIGHT (f);
+  if (alloc_width < width
+      && !pgtk_grow_gl_size (alloc_width, width, &alloc_width))
+    return false;
+  if (alloc_height < height
+      && !pgtk_grow_gl_size (alloc_height, height, &alloc_height))
+    return false;
+  resize_storage = (alloc_width != FRAME_GL_TEXTURE_WIDTH (f)
+		    || alloc_height != FRAME_GL_TEXTURE_HEIGHT (f));
+
+  glGetIntegerv (GL_TEXTURE_BINDING_2D, &old_texture);
+  glGetIntegerv (GL_RENDERBUFFER_BINDING, &old_renderbuffer);
+  pgtk_save_fbo_bindings (&saved_fbo);
+
+  /* Bind and configure the texture.  */
+  glBindTexture (GL_TEXTURE_2D, FRAME_GL_TEXTURE (f));
+  if (resize_storage)
+    glTexImage2D (GL_TEXTURE_2D, 0, GL_RGBA8, alloc_width,
+		  alloc_height, 0, GL_RGBA, GL_UNSIGNED_BYTE, NULL);
+
+  /* Check for GL errors after texture allocation - this is where
+     out-of-memory errors would typically appear.  */
+  if (pgtk_check_gl_error ("glTexImage2D"))
+    {
+      pgtk_clear_primary_gl_size (f);
+      goto out;
+    }
+
+  pgtk_configure_gl_texture_2d ();
+
+  /* Create or resize the stencil renderbuffer.  Skia needs this for
+     clip mask operations.  */
+  create_stencil = !FRAME_GL_STENCIL (f);
