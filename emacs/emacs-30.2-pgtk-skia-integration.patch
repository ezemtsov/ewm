+#ifdef USE_SKIA
+/* Skia-based frame export.
+   Export types: pdf, svg (PNG would need additional work).  */
+
+/* Callback adapter for Skia write function.  */
+struct skia_export_accumulator
+{
+  Lisp_Object data;
+};
+
+static size_t
+pgtk_skia_accumulate_data (void *ctx, const void *data, size_t size)
+{
+  struct skia_export_accumulator *acc
+    = (struct skia_export_accumulator *) ctx;
+  acc->data = Fcons (make_unibyte_string ((const char *) data, size),
+		     acc->data);
+  return size;
+}
+
+static void
+pgtk_skia_document_close_unwind (void *doc)
+{
+  emacs_skia_document_close (doc);
+}
+
+static void
+pgtk_skia_svg_canvas_finish_unwind (void *canvas)
+{
+  emacs_skia_svg_canvas_finish (canvas);
+}
+
+static void
+pgtk_skia_surface_destroy_unwind (void *surface)
+{
+  emacs_skia_surface_destroy (surface);
+}
+
+struct pgtk_skia_export_canvas_state
+{
+  struct frame *f;
+  emacs_skia_canvas_t *saved_canvas;
+};
+
+static void
+pgtk_skia_restore_export_canvas (void *arg)
+{
+  struct pgtk_skia_export_canvas_state *state = arg;
+  FRAME_SKIA_CANVAS (state->f) = state->saved_canvas;
+}
+
+static void
+pgtk_skia_export_frame_to_canvas (struct frame *f,
+				  emacs_skia_canvas_t *canvas,
+				  int width, int height)
+{
+  struct pgtk_skia_export_canvas_state state = { f, FRAME_SKIA_CANVAS (f) };
+  specpdl_ref count = SPECPDL_INDEX ();
+
+  record_unwind_protect_ptr (pgtk_skia_restore_export_canvas, &state);
+  FRAME_SKIA_CANVAS (f) = canvas;
+  emacs_skia_canvas_clear (canvas, EMACS_SKIA_COLOR_RGB (255, 255, 255));
+  expose_frame (f, 0, 0, width, height);
+  unbind_to (count, Qnil);
+}
+
+/* Export frames to PDF, SVG, or PNG using Skia.
+   Returns the exported data as a unibyte string.  */
+Lisp_Object
+pgtk_skia_export_frames (Lisp_Object frames, Lisp_Object type)
+{
+  struct frame *f;
+  int width, height;
+  struct skia_export_accumulator acc = { Qnil };
+  bool is_pdf = NILP (type) || EQ (type, Qpdf);
+  bool is_svg = EQ (type, Qsvg);
+  bool is_png = EQ (type, Qpng);
+  struct pgtk_skia_input_block_state input_block;
+  specpdl_ref count = SPECPDL_INDEX ();
+  Lisp_Object result;
+
+  if (!is_pdf && !is_svg && !is_png)
+    error ("Skia export supports pdf, svg, and png types");
+  if (is_pdf && !emacs_skia_has_pdf_support ())
+    error ("Skia PDF export is not available in this build");
+  if (is_svg && !emacs_skia_has_svg_support ())
+    error ("Skia SVG export is not available in this build");
+
+  if ((is_svg || is_png) && !NILP (XCDR (frames)))
+    error ("SVG and PNG export cannot handle multiple frames");
+
+  specbind (Qredisplay_dont_pause, Qt);
+  redisplay_preserve_echo_area (31);
+
+  f = XFRAME (XCAR (frames));
+  frames = XCDR (frames);
+  width = FRAME_PIXEL_WIDTH (f);
+  height = FRAME_PIXEL_HEIGHT (f);
+
+  pgtk_skia_block_input_with_unwind (&input_block);
+
+  if (is_pdf)
+    {
+      specpdl_ref doc_count;
+
+      /* Create PDF document.  */
+      emacs_skia_document_t *doc
+	= emacs_skia_document_create_pdf (pgtk_skia_accumulate_data,
+					  &acc);
+      if (!doc)
+	error ("Failed to create PDF document");
+      doc_count = SPECPDL_INDEX ();
+      record_unwind_protect_ptr (pgtk_skia_document_close_unwind, doc);
+
+      while (1)
+	{
+	  emacs_skia_canvas_t *canvas
+	    = emacs_skia_document_begin_page (doc, width, height);
+	  if (!canvas)
+	    error ("Failed to begin PDF page");
+
+	  pgtk_skia_export_frame_to_canvas (f, canvas, width, height);
+	  emacs_skia_document_end_page (doc);
+
+	  if (NILP (frames))
+	    break;
+
+	  f = XFRAME (XCAR (frames));
+	  frames = XCDR (frames);
+	  width = FRAME_PIXEL_WIDTH (f);
+	  height = FRAME_PIXEL_HEIGHT (f);
+
+	  pgtk_skia_maybe_quit (&input_block);
+	}
+
+      unbind_to (doc_count, Qnil);
+    }
+  else if (is_svg)
+    {
+      specpdl_ref canvas_count;
+
+      /* Create SVG canvas.  */
+      emacs_skia_canvas_t *canvas
+	= emacs_skia_svg_canvas_create (pgtk_skia_accumulate_data,
+					&acc, width, height);
+      if (!canvas)
+	error ("Failed to create SVG canvas");
+      canvas_count = SPECPDL_INDEX ();
+      record_unwind_protect_ptr (pgtk_skia_svg_canvas_finish_unwind, canvas);
+
+      pgtk_skia_export_frame_to_canvas (f, canvas, width, height);
+      unbind_to (canvas_count, Qnil);
+    }
+  else if (is_png)
+    {
+      specpdl_ref surface_count;
+
+      /* Create a temporary raster surface for PNG export.  */
+      emacs_skia_surface_t *png_surface
+	= emacs_skia_surface_create_raster (width, height);
+      if (!png_surface)
+	error ("Failed to create PNG surface");
+      surface_count = SPECPDL_INDEX ();
+      record_unwind_protect_ptr (pgtk_skia_surface_destroy_unwind,
+				 png_surface);
+
+      emacs_skia_canvas_t *canvas
+	= emacs_skia_surface_get_canvas (png_surface);
+      if (!canvas)
+	error ("Failed to get PNG canvas");
+
+      pgtk_skia_export_frame_to_canvas (f, canvas, width, height);
+
+      /* Flush the surface and encode to PNG.  */
+      emacs_skia_surface_flush (png_surface);
+      if (!emacs_skia_surface_write_to_png (png_surface,
+					    pgtk_skia_accumulate_data,
+					    &acc))
+	error ("Failed to encode PNG");
+
+      unbind_to (surface_count, Qnil);
+    }
+
+  pgtk_skia_unblock_input (&input_block);
+
+  result = CALLN (Fapply, Qconcat, Fnreverse (acc.data));
+  return unbind_to (count, result);
+}
+#endif /* USE_SKIA */
