+	  || FRAME_SKIA_SURFACE (f)
+	  || FRAME_GL_FRAMEBUFFER (f)
+	  || FRAME_GL_TEXTURE (f)
+	  || FRAME_GL_STENCIL (f)
+	  || FRAME_GL_RESIZE_FRAMEBUFFER (f)
+	  || FRAME_GL_RESIZE_TEXTURE (f));
