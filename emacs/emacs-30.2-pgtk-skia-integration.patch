+static void
+pgtk_save_fbo_bindings (struct pgtk_fbo_bindings *saved)
+{
+  glGetIntegerv (GL_READ_FRAMEBUFFER_BINDING, &saved->read);
+  glGetIntegerv (GL_DRAW_FRAMEBUFFER_BINDING, &saved->draw);
+}
+
+static void
+pgtk_restore_fbo_bindings (struct frame *f,
+			   const struct pgtk_fbo_bindings *saved)
+{
+  glBindFramebuffer (GL_READ_FRAMEBUFFER, saved->read);
+  glBindFramebuffer (GL_DRAW_FRAMEBUFFER, saved->draw);
+  FRAME_SKIA_GL_STATE_DIRTY (f) = true;
+}
