+
+static void
+pgtk_skia_block_input_with_unwind (struct pgtk_skia_input_block_state *state)
+{
+  state->blocked = false;
+  record_unwind_protect_ptr (pgtk_skia_unblock_input_unwind, state);
+  block_input ();
+  state->blocked = true;
+}
+
+static void
+pgtk_skia_unblock_input (struct pgtk_skia_input_block_state *state)
+{
+  state->blocked = false;
+  unblock_input ();
+}
+
+static void
+pgtk_skia_maybe_quit (struct pgtk_skia_input_block_state *state)
+{
+  pgtk_skia_unblock_input (state);
+  maybe_quit ();
+  block_input ();
+  state->blocked = true;
+}
