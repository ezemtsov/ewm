+  FRAME_SKIA_SURFACE (f)
+    = emacs_skia_surface_create_gl (FRAME_SKIA_GL_CONTEXT (f),
+				    width, height,
+				    FRAME_GL_FRAMEBUFFER (f));
+  if (FRAME_SKIA_SURFACE (f))
+    return;
