+struct pgtk_skia_input_block_state
+{
+  bool blocked;
+};
+
+static void
+pgtk_skia_unblock_input_unwind (void *arg)
+{
+  struct pgtk_skia_input_block_state *state = arg;
+
+  if (state->blocked)
+    unblock_input ();
