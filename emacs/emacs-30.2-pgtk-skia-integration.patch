+  FRAME_GL_TEXTURE_WIDTH (f) = alloc_width;
+  FRAME_GL_TEXTURE_HEIGHT (f) = alloc_height;
+  FRAME_GL_RENDER_WIDTH (f) = width;
+  FRAME_GL_RENDER_HEIGHT (f) = height;
+  ok = true;
