+static void
+pgtk_skia_surface_device_size (struct frame *f, int *width,
+			       int *height, int *scale)
+{
+  int logical_width = FRAME_SKIA_SURFACE_DESIRED_WIDTH (f);
+  int logical_height = FRAME_SKIA_SURFACE_DESIRED_HEIGHT (f);
+  int frame_scale = pgtk_gl_scale (f);
+
+  if (logical_width <= 0)
+    logical_width = 1;
+  if (logical_height <= 0)
+    logical_height = 1;
