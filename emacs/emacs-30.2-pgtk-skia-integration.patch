+/* Ensure GL framebuffer/texture objects exist.  Completeness is checked
+   when storage is created or resized by pgtk_setup_gl_framebuffer; avoid
+   checking it again on every draw, since binding the FBO here dirties
+   Skia's cached GL state and forces an otherwise unnecessary reset.  */
+static bool
+pgtk_ensure_gl_framebuffer (struct frame *f, int width, int height,
+                            bool *recreated)
+{
+  bool needs_setup = false;
+
+  if (recreated)
+    *recreated = false;
+
+  if (!FRAME_GL_FRAMEBUFFER (f))
+    {
+      glGenFramebuffers (1, &FRAME_GL_FRAMEBUFFER (f));
+      needs_setup = true;
+    }
+  if (!FRAME_GL_TEXTURE (f))
+    {
+      glGenTextures (1, &FRAME_GL_TEXTURE (f));
+      pgtk_clear_primary_gl_size (f);
+      needs_setup = true;
+    }
+  if (!FRAME_GL_STENCIL (f))
+    {
+      glGenRenderbuffers (1, &FRAME_GL_STENCIL (f));
+      needs_setup = true;
+    }
+
+  if (needs_setup)
+    {
+      if (recreated)
+        *recreated = true;
+      if (!pgtk_setup_gl_framebuffer (f, width, height, true))
+        return false;
+      pgtk_destroy_skia_surface (f);
+    }
+
+  return true;
