+void
+emacs_skia_image_destroy (emacs_skia_image_t *image)
+{
+  delete image;
+}
+
+emacs_skia_image_t *
+emacs_skia_image_create_from_bitmap (const unsigned char *data,
+				     int width, int height,
+				     int stride)
+{
+  if (!data || width <= 0 || height <= 0)
+    return nullptr;
+
+  int min_stride = (width - 1) / 8 + 1;
+
+  /* Calculate stride if not provided.  */
+  if (stride <= 0)
+    stride = min_stride;
+  else if (stride < min_stride)
+    return nullptr;
+
+  if ((size_t) height > SIZE_MAX / (size_t) width)
+    return nullptr;
+
+  /* Convert 1-bit packed data to 8-bit alpha.
+     Cairo A1 format: MSB first, rows padded to 32-bit boundary.
+     We convert to Skia A8 format for compatibility.  */
+  int a8_stride = width;
+  size_t a8_size = (size_t) width * (size_t) height;
+  std::unique_ptr<uint8_t[]> a8_data (new uint8_t[a8_size]);
+
+  for (int y = 0; y < height; y++)
+    {
+      const unsigned char *src_row = data + y * stride;
+      uint8_t *dst_row = a8_data.get () + y * a8_stride;
+
+      for (int x = 0; x < width; x++)
+	{
+	  int byte_idx = x / 8;
+	  int bit_idx = 7 - (x % 8); /* MSB first */
+	  bool bit_set = (src_row[byte_idx] >> bit_idx) & 1;
+	  dst_row[x] = bit_set ? 255 : 0;
+	}
+    }
+
+  /* Create A8 (alpha-only) image */
+  SkImageInfo info
+    = SkImageInfo::Make (width, height, kAlpha_8_SkColorType,
+			 kPremul_SkAlphaType);
+  sk_sp<SkImage> image = SkImages::RasterFromPixmap (
+    SkPixmap (info, a8_data.get (), a8_stride),
+    [] (const void *, void *context) {
+      delete[] static_cast<uint8_t *> (context);
+    },
+    a8_data.get ());
+  if (image)
+    a8_data.release ();
+  return make_image (std::move (image));
+}
