+#ifdef SK_GL
+static emacs_skia_surface_t *
+make_surface (sk_sp<SkSurface> surface,
+	      sk_sp<GrDirectContext> context = nullptr)
+#else
+static emacs_skia_surface_t *
+make_surface (sk_sp<SkSurface> surface)
+#endif
+{
+  if (!surface)
+    return nullptr;
