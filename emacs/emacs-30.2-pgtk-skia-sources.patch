+/* ============================================================
+   GL Context
+   ============================================================ */
+
+/* Create GL context using the native GL interface.  This uses the
+   currently active GL context (e.g., set by GDK).  */
+
+#ifdef SK_GL
+static GrGLFuncPtr
+get_gl_proc (void *ctx, const char *name)
+{
+  (void) ctx;
+
+  /* Match GDK's EGL-backed contexts first.  This avoids resolving GL
+     entry points from a different client library on Wayland/GLES.  */
+  auto proc
+    = reinterpret_cast<GrGLFuncPtr> (epoxy_eglGetProcAddress (name));
+  if (proc)
+    return proc;
+
+  static void *gl_lib_handle = nullptr;
+  if (!gl_lib_handle)
+    {
+      gl_lib_handle = dlopen ("libGL.so.1", RTLD_LAZY | RTLD_LOCAL);
+      if (!gl_lib_handle)
+	gl_lib_handle = dlopen ("libGL.so", RTLD_LAZY | RTLD_LOCAL);
+      if (!gl_lib_handle)
+	gl_lib_handle = dlopen ("libGLESv2.so.2", RTLD_LAZY | RTLD_LOCAL);
+      if (!gl_lib_handle)
+	gl_lib_handle = dlopen ("libGLESv2.so", RTLD_LAZY | RTLD_LOCAL);
+    }
+
+  if (!gl_lib_handle)
+    return nullptr;
+
+  return reinterpret_cast<GrGLFuncPtr> (dlsym (gl_lib_handle, name));
+}
+
+static emacs_skia_gl_context_t *
+make_gl_context (sk_sp<const GrGLInterface> interface,
+		 const char *interface_error, const char *context_error)
+{
+  if (!interface)
+    {
+      fprintf (stderr, "%s\n", interface_error);
+      return nullptr;
+    }
+
+  auto context = GrDirectContexts::MakeGL (interface);
+  if (!context)
+    {
+      fprintf (stderr, "%s\n", context_error);
+      return nullptr;
+    }
+
+  return new emacs_skia_gl_context_t { context };
+}
+#endif
+
+emacs_skia_gl_context_t *
+emacs_skia_gl_context_create_native (void)
+{
+#ifdef SK_GL
+  return make_gl_context (
+    GrGLMakeAssembledInterface (nullptr, get_gl_proc),
+    "Skia: Failed to create GL interface (is GL context current?)",
+    "Skia: Failed to create GrDirectContext (GL version may be too old)");
+#else
+  return nullptr;
+#endif
+}
+
+#ifdef SK_GL
+void
+emacs_skia_gl_context_destroy (emacs_skia_gl_context_t *ctx)
+{
+  if (ctx)
+    {
+      if (ctx->context && !ctx->abandoned)
+	ctx->context->releaseResourcesAndAbandonContext ();
+      delete ctx;
+    }
+}
+
+void
+emacs_skia_gl_context_abandon (emacs_skia_gl_context_t *ctx)
+{
+  if (ctx && ctx->context && !ctx->abandoned)
+    {
+      ctx->context->abandonContext ();
+      ctx->abandoned = true;
+    }
+}
+
+void
+emacs_skia_gl_context_reset (emacs_skia_gl_context_t *ctx)
+{
+  if (ctx && ctx->context && !ctx->abandoned)
+    {
+      /* Reset Skia's internal GL state tracking.  This is needed
+	 after destroying a surface that was wrapped around a backend
+	 render target, as Skia may have cached state related to that
+	 target. resetContext() tells Skia to re-query GL state on
+	 next use.  */
+      ctx->context->resetContext ();
+    }
+}
+#else
+void
+emacs_skia_gl_context_destroy (emacs_skia_gl_context_t *ctx)
+{
+  (void) ctx;
+}
+
+void
+emacs_skia_gl_context_abandon (emacs_skia_gl_context_t *ctx)
+{
+  (void) ctx;
+}
+
+void
+emacs_skia_gl_context_reset (emacs_skia_gl_context_t *ctx)
+{
+  (void) ctx;
+}
+#endif
