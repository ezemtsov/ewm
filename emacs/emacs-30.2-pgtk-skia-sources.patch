+#ifdef SK_GL
+  return new emacs_skia_surface_t {
+    surface, context, { nullptr, nullptr, nullptr }
+  };
+#else
+  return new emacs_skia_surface_t {
+    surface, { nullptr, nullptr, nullptr }
+  };
+#endif
+}
