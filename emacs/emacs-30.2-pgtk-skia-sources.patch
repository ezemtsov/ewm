+template <typename T, int stack_count>
+class emacs_skia_stack_array
+{
+public:
+  explicit emacs_skia_stack_array (int count)
+    : heap_ (count > stack_count ? new T[count] : nullptr),
+      data_ (heap_ ? heap_.get () : stack_)
+  {}
+
+  T *get () { return data_; }
+  const T *get () const { return data_; }
+  T &operator[] (int i) { return data_[i]; }
+
+private:
+  T stack_[stack_count];
+  std::unique_ptr<T[]> heap_;
+  T *data_;
+};
