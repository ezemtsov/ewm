+/* ============================================================
+   PNG Export
+   ============================================================ */
+
+/* Write surface to PNG using a callback function.
+   Returns true on success, false on failure.  */
+bool
+emacs_skia_surface_write_to_png (emacs_skia_surface_t *surface,
+				 emacs_skia_write_fn write_fn,
+				 void *write_ctx)
+{
+  if (!surface || !surface->surface || !write_fn)
+    return false;
+
+  /* Create an image snapshot of the surface.  */
+  sk_sp<SkImage> image = surface->surface->makeImageSnapshot ();
+  if (!image)
+    return false;
+
+#ifdef SK_GL
+  GrDirectContext *ctx = surface->context ? surface->context.get () : nullptr;
+  sk_sp<SkData> data = SkPngEncoder::Encode (ctx, image.get (), {});
+#else
+  sk_sp<SkData> data = SkPngEncoder::Encode (nullptr, image.get (), {});
+#endif
+  if (!data)
+    return false;
+
+  size_t written = write_fn (write_ctx, data->data (), data->size ());
+  return written == data->size ();
+}
+
+/* Draw an image with transformation applied.  */
+void
+emacs_skia_canvas_draw_image_transformed (emacs_skia_canvas_t *canvas,
+					  emacs_skia_image_t *image,
+					  const double matrix[3][3],
+					  float x, float y,
+					  bool smooth,
+					  emacs_skia_paint_t *paint)
+{
+  if (!canvas || !canvas->canvas || !image || !image->image)
+    return;
+
+  SkAutoCanvasRestore restore (canvas->canvas, true);
+  canvas->canvas->translate (x, y);
+
+  if (matrix)
+    {
+      SkMatrix display_to_image;
+      display_to_image.setAll (matrix[0][0], matrix[1][0], matrix[2][0],
+			       matrix[0][1], matrix[1][1], matrix[2][1],
+			       matrix[0][2], matrix[1][2], matrix[2][2]);
+
+      SkMatrix image_to_display;
+      if (!display_to_image.invert (&image_to_display))
+	return;
+      canvas->canvas->concat (image_to_display);
+    }
+
+  SkSamplingOptions sampling (smooth ? SkFilterMode::kLinear
+				     : SkFilterMode::kNearest);
+
+  canvas->canvas->drawImage (image->image.get (), 0, 0, sampling,
+			     paint ? &paint->paint : nullptr);
+}
