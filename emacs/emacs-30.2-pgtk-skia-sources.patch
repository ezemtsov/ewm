+emacs_skia_glyph_t
+emacs_skia_font_char_to_glyph (emacs_skia_font_t *font,
+			       int32_t codepoint)
+{
+  if (!font)
+    {
+      return 0;
+    }
+  return font->font.unicharToGlyph (codepoint);
+}
