+/* ============================================================
+   Surface
+   ============================================================ */
+
+emacs_skia_surface_t *
+emacs_skia_surface_create_raster (int width, int height)
+{
+  SkImageInfo info = SkImageInfo::MakeN32Premul (width, height);
+  return make_surface (SkSurfaces::Raster (info));
+}
+
+#ifdef SK_GL
+emacs_skia_surface_t *
+emacs_skia_surface_create_gl (emacs_skia_gl_context_t *ctx, int width,
+			      int height, unsigned int framebuffer_id,
+			      float scale)
+{
+  if (!ctx || !ctx->context)
+    return nullptr;
+
+  GrGLFramebufferInfo fbInfo;
+  fbInfo.fFBOID = framebuffer_id;
+  fbInfo.fFormat = GL_RGBA8;
+
+  /* Create backend render target with stencil buffer for clip mask
+     operations.  */
+  auto backendRT
+    = GrBackendRenderTargets::MakeGL (width, height,
+				      GL_SURFACE_MSAA_SAMPLES,
+				      GL_SURFACE_STENCIL_BITS, fbInfo);
+
+  auto surface = SkSurfaces::
+    WrapBackendRenderTarget (ctx->context.get (), backendRT,
+			     kBottomLeft_GrSurfaceOrigin,
+			     kRGBA_8888_SkColorType, SkColorSpace::MakeSRGB (),
+			     nullptr);
+  if (surface && scale > 1.0f)
+    surface->getCanvas ()->scale (scale, scale);
+
+  /* Share ownership to prevent dangling pointer.  */
+  return make_surface (surface, ctx->context);
+}
+#else
+emacs_skia_surface_t *
+emacs_skia_surface_create_gl (emacs_skia_gl_context_t *ctx, int width,
+			      int height, unsigned int framebuffer_id,
+			      float scale)
+{
+  (void) ctx;
+  (void) width;
+  (void) height;
+  (void) framebuffer_id;
+  (void) scale;
+  return nullptr;
+}
+#endif
+
+void
+emacs_skia_surface_destroy (emacs_skia_surface_t *surface)
+{
+  delete surface;
+}
+
+emacs_skia_canvas_t *
+emacs_skia_surface_get_canvas (emacs_skia_surface_t *surface)
+{
+  if (!surface || !surface->surface)
+    return nullptr;
+
+  /* Use the per-surface canvas wrapper to avoid thread-safety issues.
+     The canvas pointer is borrowed from the SkSurface.  */
+  surface->canvas_wrapper.canvas = surface->surface->getCanvas ();
+  return &surface->canvas_wrapper;
+}
+
+void *
+emacs_skia_surface_get_pixels (emacs_skia_surface_t *surface)
+{
+  if (!surface || !surface->surface)
+    {
+      return nullptr;
+    }
+  SkPixmap pixmap;
+  if (surface->surface->peekPixels (&pixmap))
+    {
+      return const_cast<void *> (pixmap.addr ());
+    }
+  return nullptr;
+}
+
+void
+emacs_skia_surface_flush (emacs_skia_surface_t *surface)
+{
+  if (surface && surface->surface)
+    {
+      /* IMPORTANT: The caller must ensure the GL context is valid
+	 and current before calling this function.  flushAndSubmit
+	 calls GrGLGpu::onSubmitToGpu which calls glGetError,
+	 triggering Mesa's glthread to drain pending commands.
+	 If the EGL context was lost (e.g. during compositor
+	 shutdown), those commands may reference stale/freed
+	 buffers, causing a SIGSEGV in the driver.  Callers
+	 should verify gdk_gl_context_get_current() matches
+	 their expected context before calling this.  */
+#ifdef SK_GL
+      if (surface->context)
+	surface->context.get ()->flushAndSubmit (surface->surface.get (),
+						GrSyncCpu::kNo);
+#endif
+    }
+}
+
+emacs_skia_image_t *
+emacs_skia_surface_make_image_snapshot (emacs_skia_surface_t *surface,
+					const emacs_skia_irect_t *rect)
+{
+  if (!surface || !surface->surface)
+    return nullptr;
+
+  if (!rect)
+    return make_image (surface->surface->makeImageSnapshot ());
+
+  SkIRect sk_rect = SkIRect::MakeLTRB (rect->left, rect->top,
+				       rect->right, rect->bottom);
+  return make_image (surface->surface->makeImageSnapshot (sk_rect));
+}
