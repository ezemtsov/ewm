+DEFUN ("pgtk-skia-test-font-ft-size-p",
+       Fpgtk_skia_test_font_ft_size_p,
+       Spgtk_skia_test_font_ft_size_p, 1, 1, 0,
+       doc: /* Return non-nil if FONT-OBJECT has a live FreeType size.
+This is a local Skia smoke hook for checking that Skia-owned FreeType font
+state is available to inherited FreeType callbacks for the font lifetime.  */)
+  (Lisp_Object font_object)
+{
+  struct font *font = CHECK_FONT_GET_OBJECT (font_object);
+  struct font_info *info = (struct font_info *) font;
+
+  return info->ft_face && info->ft_size && info->ft_size->face == info->ft_face
+    ? Qt : Qnil;
+}
