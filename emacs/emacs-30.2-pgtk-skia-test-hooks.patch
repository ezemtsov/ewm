+DEFUN ("pgtk-skia-test-framebuffer-size",
+       Fpgtk_skia_test_framebuffer_size,
+       Spgtk_skia_test_framebuffer_size, 0, 1, 0,
+       doc: /* Return Skia GL framebuffer sizing for FRAME.
+The return value is (RENDER-WIDTH RENDER-HEIGHT TEXTURE-WIDTH TEXTURE-HEIGHT
+LOGICAL-WIDTH LOGICAL-HEIGHT SCALE).  If FRAME is nil, use the selected
+frame.  */)
+  (Lisp_Object frame)
+{
+  struct frame *f = decode_window_system_frame (frame);
+
+  if (!FRAME_GDK_GL_CONTEXT (f) || !FRAME_GL_FRAMEBUFFER (f))
+    return Qnil;
+
+  return CALLN (Flist,
+		make_int (FRAME_GL_RENDER_WIDTH (f)),
+		make_int (FRAME_GL_RENDER_HEIGHT (f)),
+		make_int (FRAME_GL_TEXTURE_WIDTH (f)),
+		make_int (FRAME_GL_TEXTURE_HEIGHT (f)),
+		make_int (FRAME_SKIA_SURFACE_DESIRED_WIDTH (f)),
+		make_int (FRAME_SKIA_SURFACE_DESIRED_HEIGHT (f)),
+		make_int (pgtk_gl_scale (f)));
+}
