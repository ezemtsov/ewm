+DEFUN ("pgtk-skia-test-clear-area",
+       Fpgtk_skia_test_clear_area,
+       Spgtk_skia_test_clear_area, 0, 1, 0,
+       doc: /* Draw red, clear a subrectangle through pgtk_clear_area, and
+return (LEFT CLEARED RIGHT) sample rectangles.
+If FRAME is nil, use the selected frame.  This is intended for deterministic
+Skia alpha-background smoke tests of the production clear-area path.  */)
+  (Lisp_Object frame)
+{
+  struct frame *f = decode_window_system_frame (frame);
+  emacs_skia_canvas_t *canvas = pgtk_begin_skia_clip (f);
+  if (!canvas)
+    return Qnil;
+
+  int left = 48;
+  int top = 56;
+  int width = 240;
+  int height = 96;
+  int clear_left = 112;
+  int clear_top = 80;
+  int clear_width = 96;
+  int clear_height = 48;
+
+  emacs_skia_irect_t red_rect
+    = { left, top, left + width, top + height };
+  emacs_skia_paint_t *paint = FRAME_SKIA_PAINT (f);
+
+  emacs_skia_paint_set_color (paint, EMACS_SKIA_COLOR (255, 255, 0, 0));
+  emacs_skia_paint_set_blend_mode (paint, EMACS_SKIA_BLEND_SRC_OVER);
+  emacs_skia_paint_set_stroke (paint, false);
+  emacs_skia_canvas_draw_irect (canvas, &red_rect, paint);
+
+  pgtk_end_skia_clip (f);
+  pgtk_clear_area (f, clear_left, clear_top, clear_width, clear_height);
+
+  if (FRAME_SKIA_SURFACE (f))
+    emacs_skia_surface_flush (FRAME_SKIA_SURFACE (f));
+
+  return list3 (list4 (make_int (left), make_int (top),
+		       make_int (clear_left - left), make_int (height)),
+		list4 (make_int (clear_left), make_int (clear_top),
+		       make_int (clear_width), make_int (clear_height)),
+		list4 (make_int (clear_left + clear_width), make_int (top),
+		       make_int (left + width - clear_left - clear_width),
+		       make_int (height)));
+}
