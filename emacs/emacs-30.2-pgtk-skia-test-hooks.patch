+DEFUN ("pgtk-skia-test-setup-state-preserved",
+       Fpgtk_skia_test_setup_state_preserved,
+       Spgtk_skia_test_setup_state_preserved, 0, 1, 0,
+       doc: /* Return GL state preservation checks for framebuffer setup.
+The return value is (OK TEXTURE RENDERBUFFER READ-FBO DRAW-FBO).
+If FRAME is nil, use the selected frame.  This is intended for fast
+deterministic Skia backend smoke tests.  */)
+  (Lisp_Object frame)
+{
+  struct frame *f = decode_window_system_frame (frame);
+  GLuint sentinel_texture = 0;
+  GLuint sentinel_renderbuffer = 0;
+  GLuint sentinel_read_framebuffer = 0;
+  GLuint sentinel_draw_framebuffer = 0;
+  GLint old_texture = 0;
+  GLint old_renderbuffer = 0;
+  GLint old_read_framebuffer = 0;
+  GLint old_draw_framebuffer = 0;
+  GLint after_texture = 0;
+  GLint after_renderbuffer = 0;
+  GLint after_read_framebuffer = 0;
+  GLint after_draw_framebuffer = 0;
+  bool ok;
+
+  if (!FRAME_GDK_GL_CONTEXT (f)
+      || !FRAME_GL_FRAMEBUFFER (f)
+      || !FRAME_GL_TEXTURE (f)
+      || !FRAME_GL_STENCIL (f)
+      || FRAME_GL_RENDER_WIDTH (f) <= 0
+      || FRAME_GL_RENDER_HEIGHT (f) <= 0)
+    return Qnil;
+
+  if (!pgtk_skia_make_gl_context_current (f))
+    return Qnil;
+
+  glGetIntegerv (GL_TEXTURE_BINDING_2D, &old_texture);
+  glGetIntegerv (GL_RENDERBUFFER_BINDING, &old_renderbuffer);
+  glGetIntegerv (GL_READ_FRAMEBUFFER_BINDING, &old_read_framebuffer);
+  glGetIntegerv (GL_DRAW_FRAMEBUFFER_BINDING, &old_draw_framebuffer);
+
+  glGenTextures (1, &sentinel_texture);
+  glBindTexture (GL_TEXTURE_2D, sentinel_texture);
+  glGenRenderbuffers (1, &sentinel_renderbuffer);
+  glBindRenderbuffer (GL_RENDERBUFFER, sentinel_renderbuffer);
+  glGenFramebuffers (1, &sentinel_read_framebuffer);
+  glGenFramebuffers (1, &sentinel_draw_framebuffer);
+  glBindFramebuffer (GL_READ_FRAMEBUFFER, sentinel_read_framebuffer);
+  glBindFramebuffer (GL_DRAW_FRAMEBUFFER, sentinel_draw_framebuffer);
+
+  pgtk_clear_gl_errors ();
+  ok = pgtk_setup_gl_framebuffer (f, FRAME_GL_RENDER_WIDTH (f),
+				  FRAME_GL_RENDER_HEIGHT (f), true);
+  if (pgtk_check_gl_error ("setup state preservation"))
+    ok = false;
+
+  glGetIntegerv (GL_TEXTURE_BINDING_2D, &after_texture);
+  glGetIntegerv (GL_RENDERBUFFER_BINDING, &after_renderbuffer);
+  glGetIntegerv (GL_READ_FRAMEBUFFER_BINDING, &after_read_framebuffer);
+  glGetIntegerv (GL_DRAW_FRAMEBUFFER_BINDING, &after_draw_framebuffer);
+
+  glBindFramebuffer (GL_READ_FRAMEBUFFER, old_read_framebuffer);
+  glBindFramebuffer (GL_DRAW_FRAMEBUFFER, old_draw_framebuffer);
+  glBindRenderbuffer (GL_RENDERBUFFER, old_renderbuffer);
+  glBindTexture (GL_TEXTURE_2D, old_texture);
+  if (sentinel_read_framebuffer)
+    glDeleteFramebuffers (1, &sentinel_read_framebuffer);
+  if (sentinel_draw_framebuffer)
+    glDeleteFramebuffers (1, &sentinel_draw_framebuffer);
+  if (sentinel_renderbuffer)
+    glDeleteRenderbuffers (1, &sentinel_renderbuffer);
+  if (sentinel_texture)
+    glDeleteTextures (1, &sentinel_texture);
+  FRAME_SKIA_GL_STATE_DIRTY (f) = true;
+
+  return list5 (ok ? Qt : Qnil,
+		(sentinel_texture
+		 && after_texture == (GLint) sentinel_texture)
+		? Qt : Qnil,
+		(sentinel_renderbuffer
+		 && after_renderbuffer == (GLint) sentinel_renderbuffer)
+		? Qt : Qnil,
+		(sentinel_read_framebuffer
+		 && after_read_framebuffer
+		 == (GLint) sentinel_read_framebuffer)
+		? Qt : Qnil,
+		(sentinel_draw_framebuffer
+		 && after_draw_framebuffer
+		 == (GLint) sentinel_draw_framebuffer)
+		? Qt : Qnil);
+}
