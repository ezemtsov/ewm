+DEFUN ("pgtk-skia-test-draw-multirect-clip",
+       Fpgtk_skia_test_draw_multirect_clip,
+       Spgtk_skia_test_draw_multirect_clip, 0, 1, 0,
+       doc: /* Draw red through two disjoint Skia clip rectangles on FRAME.
+If FRAME is nil, use the selected frame.  This is intended for tests of the
+Skia multi-rectangle clip-union path.  Return (LEFT GAP RIGHT) rectangles.  */)
+  (Lisp_Object frame)
+{
+  struct frame *f = decode_window_system_frame (frame);
+  emacs_skia_canvas_t *canvas = pgtk_begin_skia_clip (f);
+  if (!canvas)
+    return Qnil;
+
+  struct window *w = XWINDOW (FRAME_SELECTED_WINDOW (f));
+  int window_x, window_y;
+  window_box (w, TEXT_AREA, &window_x, &window_y, 0, 0);
+
+  XRectangle clips[2] = {
+    { window_x + 40, window_y + 40, 70, 60 },
+    { window_x + 180, window_y + 40, 70, 60 },
+  };
+  XRectangle gap = { window_x + 110, window_y + 40, 70, 60 };
+  emacs_skia_irect_t draw_rect
+    = { clips[0].x, clips[0].y,
+	clips[1].x + clips[1].width,
+	clips[1].y + clips[1].height };
+  emacs_skia_paint_t *paint = FRAME_SKIA_PAINT (f);
+
+  emacs_skia_paint_set_color (paint, EMACS_SKIA_COLOR (255, 0, 255, 0));
+  emacs_skia_paint_set_blend_mode (paint, EMACS_SKIA_BLEND_SRC_OVER);
+  emacs_skia_paint_set_stroke (paint, false);
+  emacs_skia_canvas_draw_irect (canvas, &draw_rect, paint);
+
+  emacs_skia_canvas_save (canvas);
+  pgtk_skia_set_clip_rectangles (f, canvas, clips, 2);
+  emacs_skia_paint_set_color (paint, EMACS_SKIA_COLOR (255, 255, 0, 0));
+  emacs_skia_canvas_draw_irect (canvas, &draw_rect, paint);
+  emacs_skia_canvas_restore (canvas);
+
+  pgtk_end_skia_clip (f);
+  emacs_skia_surface_flush (FRAME_SKIA_SURFACE (f));
+  return list3 (list4 (make_int (clips[0].x), make_int (clips[0].y),
+		       make_int (clips[0].width), make_int (clips[0].height)),
+		list4 (make_int (gap.x), make_int (gap.y),
+		       make_int (gap.width), make_int (gap.height)),
+		list4 (make_int (clips[1].x), make_int (clips[1].y),
+		       make_int (clips[1].width), make_int (clips[1].height)));
+}
+
+DEFUN ("pgtk-skia-test-draw-glyph-overlap-clip",
+       Fpgtk_skia_test_draw_glyph_overlap_clip,
+       Spgtk_skia_test_draw_glyph_overlap_clip, 0, 1, 0,
+       doc: /* Draw red through glyph overlap clipping on FRAME.
+If FRAME is nil, use the selected frame.  This uses the production
+`get_glyph_string_clip_rects' and `pgtk_skia_set_glyph_string_clipping'
+caller shape with synthetic row geometry, so tests can cover the
+multi-rectangle glyph clipping path without redrawing live overlap rows.
+Return (TOP GAP BOTTOM) sample rectangles.  */)
+  (Lisp_Object frame)
+{
+  struct frame *f = decode_window_system_frame (frame);
+  emacs_skia_canvas_t *canvas = pgtk_begin_skia_clip (f);
+  if (!canvas)
+    return Qnil;
+
+  struct window *w = XWINDOW (FRAME_SELECTED_WINDOW (f));
+  int window_x, window_width;
+  window_box (w, TEXT_AREA, &window_x, NULL, &window_width, NULL);
+
+  int text_top = WINDOW_TAB_LINE_HEIGHT (w) + WINDOW_HEADER_LINE_HEIGHT (w);
+  int text_bottom = window_text_bottom_y (w);
+  int text_height = text_bottom - text_top;
+  if (window_width < 120 || text_height < 90)
+    {
+      pgtk_end_skia_clip (f);
+      return Qnil;
+    }
+
+  int draw_left = window_x + 40;
+  int draw_width = min (220, window_width - 80);
+  int row_height = min (40, text_height / 3);
+  int row_y = text_top + (text_height - row_height) / 2;
+  int draw_top = WINDOW_TO_FRAME_PIXEL_Y (w, text_top);
+  int draw_bottom = WINDOW_TO_FRAME_PIXEL_Y (w, text_bottom);
+  int row_frame_y = WINDOW_TO_FRAME_PIXEL_Y (w, row_y);
+
+  struct glyph_row row;
+  struct glyph_string s;
+  memset (&row, 0, sizeof row);
+  memset (&s, 0, sizeof s);
+  row.y = row_y;
+  row.height = row.visible_height = row_height;
+  row.ascent = row.phys_ascent = row_height / 2;
+  row.phys_height = row_height;
+
+  s.f = f;
+  s.w = w;
+  s.row = &row;
+  s.area = TEXT_AREA;
+  s.height = row_height;
+  s.for_overlaps = OVERLAPS_BOTH;
+
+  XRectangle clips[2];
+  int n = get_glyph_string_clip_rects (&s, clips, 2);
+  if (n != 2 || clips[0].height == 0 || clips[1].height == 0)
+    {
+      pgtk_end_skia_clip (f);
+      return Qnil;
+    }
+
+  emacs_skia_irect_t draw_rect
+    = { draw_left, draw_top, draw_left + draw_width, draw_bottom };
+  emacs_skia_paint_t *paint = FRAME_SKIA_PAINT (f);
+
+  emacs_skia_paint_set_color (paint, EMACS_SKIA_COLOR (255, 0, 255, 0));
+  emacs_skia_paint_set_blend_mode (paint, EMACS_SKIA_BLEND_SRC_OVER);
+  emacs_skia_paint_set_stroke (paint, false);
+  emacs_skia_canvas_draw_irect (canvas, &draw_rect, paint);
+
+  emacs_skia_canvas_save (canvas);
+  pgtk_skia_set_glyph_string_clipping (&s, canvas);
+  emacs_skia_paint_set_color (paint, EMACS_SKIA_COLOR (255, 255, 0, 0));
+  emacs_skia_canvas_draw_irect (canvas, &draw_rect, paint);
+  emacs_skia_canvas_restore (canvas);
+
+  pgtk_end_skia_clip (f);
+  emacs_skia_surface_flush (FRAME_SKIA_SURFACE (f));
+
+  int top_height = min ((int) clips[0].height, 50);
+  int bottom_height = min ((int) clips[1].height, 50);
+  return list3 (list4 (make_int (draw_left), make_int (clips[0].y),
+		       make_int (draw_width), make_int (top_height)),
+		list4 (make_int (draw_left), make_int (row_frame_y),
+		       make_int (draw_width), make_int (row_height)),
+		list4 (make_int (draw_left), make_int (clips[1].y),
+		       make_int (draw_width), make_int (bottom_height)));
+}
