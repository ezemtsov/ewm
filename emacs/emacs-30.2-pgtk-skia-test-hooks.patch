+DEFUN ("pgtk-skia-test-input-unwind-preserved-p",
+       Fpgtk_skia_test_input_unwind_preserved_p,
+       Spgtk_skia_test_input_unwind_preserved_p, 0, 0, 0,
+       doc: /* Return non-nil if the Skia input-block unwind guard restores input state.  */)
+  (void)
+{
+  struct pgtk_skia_input_block_state state;
+  int level = interrupt_input_blocked;
+  specpdl_ref count = SPECPDL_INDEX ();
+
+  pgtk_skia_block_input_with_unwind (&state);
+  if (interrupt_input_blocked != level + 1)
+    {
+      pgtk_skia_unblock_input (&state);
+      unbind_to (count, Qnil);
+      return Qnil;
+    }
+  unbind_to (count, Qnil);
+  if (interrupt_input_blocked != level)
+    return Qnil;
+
+  count = SPECPDL_INDEX ();
+  pgtk_skia_block_input_with_unwind (&state);
+  pgtk_skia_unblock_input (&state);
+  if (interrupt_input_blocked != level)
+    {
+      unbind_to (count, Qnil);
+      return Qnil;
+    }
+  block_input ();
+  state.blocked = true;
+  unbind_to (count, Qnil);
+
+  return interrupt_input_blocked == level ? Qt : Qnil;
+}
